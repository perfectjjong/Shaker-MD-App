# OneDrive 동기화 용량 가드
# sync-settings.conf 로 복사해서 쓴다. 없으면 아래 기본값이 적용된다.

# 내려받을 확장자 화이트리스트 (쉼표 구분, 대소문자 무관)
# 여기 없는 확장자는 아예 전송되지 않는다.
# .py .html .bat .db 등은 서버가 직접 갖고 있거나 생성하므로 기본에서 뺐다.
INCLUDE_EXT="xlsx,xls,xlsm,csv,txt,json"

# 단일 파일 최대 크기. 이보다 큰 파일은 건너뛴다.
MAX_FILE_SIZE="100M"

# 한 회차에 전송할 총량 상한. 도달하면 그 회차는 멈추고 다음 회차에 이어받는다.
# 최초 1회 대량 유입(약 700MB)을 여러 회차로 쪼개 서버 부하를 낮추는 장치다.
MAX_TRANSFER="2G"

# 대상 파일시스템 여유 공간이 이보다 적으면 동기화하지 않는다 (MB)
MIN_FREE_DISK_MB="5000"
